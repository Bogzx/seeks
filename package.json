  "bugs": { "url": "https://github.com/Bogzx/seeks/issues" },
  "keywords": ["claude", "claude-code", "claude-code-plugin", "agent", "autonomous", "hooks", "verifier", "guardrails"],
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "test": "node --test test/*.test.mjs",
