{
  "name": "seeks",
  "version": "0.2.0",
  "description": "Self-running Claude Code loops — point it at one goal and leave it running. Deterministic hooks hold the budget and the guardrails; done is released only when the hook itself re-runs your checks green.",
  "license": "MIT",
  "author": "Bogdan Truta",
  "homepage": "https://github.com/Bogzx/seeks#readme",
  "repository": { "type": "git", "url": "git+https://github.com/Bogzx/seeks.git" },
  "bugs": { "url": "https://github.com/Bogzx/seeks/issues" },
  "keywords": ["claude", "claude-code", "claude-code-plugin", "agent", "autonomous", "hooks", "verifier", "guardrails"],
  "type": "module",
  "bin": { "seeks": "bin/seeks.mjs" },
  "engines": { "node": ">=18" },
  "scripts": {
    "test": "node scripts/test.mjs",
    "sync-docs": "node scripts/sync-docs.mjs",
    "e2e": "node test/e2e/run.mjs",
    "e2e:exhaustive": "node test/e2e/exhaustive.mjs"
  }
}
